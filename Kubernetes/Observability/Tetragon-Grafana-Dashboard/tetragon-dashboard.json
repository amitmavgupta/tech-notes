{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "description": "Prometheus datasource scraping the Tetragon agent /metrics endpoint",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "prometheus", "name": "Prometheus", "version": "1.0.0" },
    { "type": "panel", "id": "timeseries", "name": "Time series", "version": "" },
    { "type": "panel", "id": "stat", "name": "Stat", "version": "" },
    { "type": "panel", "id": "table", "name": "Table", "version": "" }
  ],
  "id": null,
  "uid": "tetragon-events",
  "title": "Tetragon Runtime Security Events",
  "description": "Process execution, network, file access and enforcement events observed by Tetragon, sourced from the Tetragon Prometheus metrics exporter.",
  "tags": ["tetragon", "ebpf", "security", "kubernetes"],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "label": "Datasource"
      },
      {
        "name": "namespace",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(tetragon_events_total, namespace)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Namespace"
      },
      {
        "name": "pod",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(tetragon_events_total{namespace=~\"$namespace\"}, pod)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Pod"
      },
      {
        "name": "workload",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
        "query": "label_values(tetragon_events_total{namespace=~\"$namespace\"}, workload)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "label": "Workload"
      }
    ]
  },
  "panels": [
    { "id": 100, "type": "row", "title": "Overview", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 }, "collapsed": false, "panels": [] },
    {
      "id": 1, "type": "stat", "title": "Total Event Rate",
      "description": "All Tetragon events per second (exec, exit, kprobe, lsm, etc.)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(rate(tetragon_events_total{namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[5m]))", "legendFormat": "events/s", "refId": "A" }]
    },
    {
      "id": 2, "type": "stat", "title": "Process Exec Rate",
      "description": "New processes started per second",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue" }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(rate(tetragon_events_total{type=\"PROCESS_EXEC\", namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[5m]))", "legendFormat": "exec/s", "refId": "A" }]
    },
    {
      "id": 3, "type": "stat", "title": "Enforcement Actions (SIGKILL/override)",
      "description": "Rate of tracing-policy selector actions that killed or blocked a process, e.g. the CAP_SYS_ADMIN + SIGKILL example",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(rate(tetragon_tracingpolicy_selector_actions_total{action=~\"signal|monitor_signal|override|monitor_override\"}[5m]))", "legendFormat": "actions/s", "refId": "A" }]
    },
    {
      "id": 4, "type": "stat", "title": "Events Dropped (rate limit)",
      "description": "Events dropped on export due to Tetragon's export rate limiting",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(increase(tetragon_export_ratelimit_events_dropped_total[$__range]))", "legendFormat": "dropped", "refId": "A" }]
    },

    { "id": 101, "type": "row", "title": "Process Lifecycle", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 }, "collapsed": false, "panels": [] },
    {
      "id": 5, "type": "timeseries", "title": "Event Rate by Type",
      "description": "🚀 process = PROCESS_EXEC, 💥 exit = PROCESS_EXIT, connect/sendmsg/close/read/capability = PROCESS_KPROBE",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (type) (rate(tetragon_events_total{namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[5m]))", "legendFormat": "{{type}}", "refId": "A" }]
    },
    {
      "id": 6, "type": "table", "title": "Top Executed Binaries",
      "description": "Binaries with the most PROCESS_EXEC events in the selected time range (🚀 process events)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "binary": "Binary", "pod": "Pod", "namespace": "Namespace", "Value": "Exec Count" } } }
      ],
      "targets": [{ "expr": "topk(10, sum by (binary, pod, namespace) (increase(tetragon_events_total{type=\"PROCESS_EXEC\", namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[$__range])))", "format": "table", "instant": true, "refId": "A" }]
    },

    { "id": 102, "type": "row", "title": "Network & File Activity (kprobe hooks)", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 }, "collapsed": false, "panels": [] },
    {
      "id": 7, "type": "timeseries", "title": "Kprobe Events by Hook",
      "description": "🔌 connect, 📤 sendmsg, 🧹 close, 📚 read events broken down by the tracing-policy hook that generated them",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (hook) (rate(tetragon_policy_events_total{namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[5m]))", "legendFormat": "{{hook}}", "refId": "A" }]
    },
    {
      "id": 8, "type": "table", "title": "Syscalls by Name",
      "description": "Raw syscall counts (requires the syscall-tracing / tracepoint policy to be loaded)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "syscall": "Syscall", "binary": "Binary", "pod": "Pod", "Value": "Count/s" } } }
      ],
      "targets": [{ "expr": "topk(15, sum by (syscall, binary, pod) (rate(tetragon_syscalls_total{namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[5m])))", "format": "table", "instant": true, "refId": "A" }]
    },

    { "id": 103, "type": "row", "title": "Security & Enforcement", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 }, "collapsed": false, "panels": [] },
    {
      "id": 9, "type": "timeseries", "title": "Selector Actions by Type",
      "description": "post = observed & logged, signal/monitor_signal = SIGKILL sent (💥 exit ... SIGKILL), override/monitor_override = syscall blocked",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum"] }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum by (action) (rate(tetragon_tracingpolicy_selector_actions_total[5m]))", "legendFormat": "{{action}}", "refId": "A" }]
    },
    {
      "id": 10, "type": "table", "title": "Policy Events by Policy / Hook / Pod",
      "description": "Which tracing policy + hook (e.g. capability check on /etc/shadow reads) fired, and on which pod",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "fieldConfig": { "defaults": { "custom": { "align": "auto" } }, "overrides": [] },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "policy": "Policy", "hook": "Hook", "pod": "Pod", "binary": "Binary", "Value": "Count" } } }
      ],
      "targets": [{ "expr": "topk(15, sum by (policy, hook, pod, binary) (increase(tetragon_policy_events_total{namespace=~\"$namespace\", pod=~\"$pod\", workload=~\"$workload\"}[$__range])))", "format": "table", "instant": true, "refId": "A" }]
    },
    {
      "id": 11, "type": "table", "title": "Loaded Tracing Policies",
      "description": "State of each tracing policy currently loaded into the Tetragon agent",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 32 },
      "fieldConfig": {
        "defaults": { "custom": { "align": "auto" } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "State" }, "properties": [
            { "id": "mappings", "value": [
              { "type": "value", "options": { "enabled": { "text": "enabled", "color": "green" } } },
              { "type": "value", "options": { "error": { "text": "error", "color": "red" } } },
              { "type": "value", "options": { "load_error": { "text": "load_error", "color": "red" } } },
              { "type": "value", "options": { "disabled": { "text": "disabled", "color": "orange" } } }
            ]},
            { "id": "custom.cellOptions", "value": { "type": "color-text" } }
          ]}
        ]
      },
      "options": { "showHeader": true },
      "transformations": [
        { "id": "organize", "options": { "excludeByName": { "Time": true }, "renameByName": { "state": "State", "policy_namespace": "Policy Namespace", "Value": "Value" } } }
      ],
      "targets": [{ "expr": "tetragon_tracingpolicy_loaded", "legendFormat": "{{state}}", "format": "table", "instant": true, "refId": "A" }]
    },

    { "id": 104, "type": "row", "title": "Tetragon Agent Health", "gridPos": { "h": 1, "w": 24, "x": 0, "y": 38 }, "collapsed": false, "panels": [] },
    {
      "id": 12, "type": "timeseries", "title": "Missed / Lost Events",
      "description": "Kernel-side events Tetragon failed to deliver (perf/ring buffer pressure). Non-zero values mean you may be missing events like the ones above.",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi" } },
      "targets": [
        { "expr": "sum(rate(tetragon_bpf_missed_events_total[5m]))", "legendFormat": "bpf missed events", "refId": "A" },
        { "expr": "sum(rate(tetragon_observer_ringbuf_events_lost_total[5m]))", "legendFormat": "ringbuf lost", "refId": "B" },
        { "expr": "sum(rate(tetragon_notify_overflowed_events_total[5m]))", "legendFormat": "listener buffer overflow", "refId": "C" }
      ]
    },
    {
      "id": 13, "type": "timeseries", "title": "Export Throughput",
      "description": "Bytes/sec of events exported by the Tetragon agent (what the `tetra getevents` log stream is fed from)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "fieldConfig": { "defaults": { "unit": "Bps", "custom": { "drawStyle": "line", "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [{ "expr": "sum(rate(tetragon_events_exported_bytes_total[5m]))", "legendFormat": "bytes/s", "refId": "A" }]
    },
    {
      "id": 14, "type": "stat", "title": "Tetragon Internal Error Rate",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 47 },
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 0.01 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(rate(tetragon_errors_total[5m]))", "legendFormat": "errors/s", "refId": "A" }]
    },
    {
      "id": 15, "type": "stat", "title": "Ring Buffer Errors",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 47 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "red", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(increase(tetragon_observer_ringbuf_errors_total[$__range]))", "legendFormat": "errors", "refId": "A" }]
    },
    {
      "id": 16, "type": "stat", "title": "Process Cache Size",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 47 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "blue" }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "value" },
      "targets": [{ "expr": "sum(tetragon_process_cache_size)", "legendFormat": "entries", "refId": "A" }]
    },
    {
      "id": 17, "type": "stat", "title": "Process Cache Evictions",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 47 },
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" }, "thresholds": { "steps": [{ "color": "green" }, { "color": "orange", "value": 1 }] } }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "value" },
      "targets": [{ "expr": "sum(rate(tetragon_process_cache_evictions_total[5m]))", "legendFormat": "evictions/s", "refId": "A" }]
    }
  ]
}
